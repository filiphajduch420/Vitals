    "Vitals" : {

    },
    "When enabled, Vitals sends an HTTPS request to the external service api.ipify.org to look up your public IP address. Off by default." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnuto, Vitals odešle HTTPS požadavek na externí službu api.ipify.org pro zjištění vaší veřejné IP adresy. Ve výchozím stavu vypnuto."
          }
        }
      }
    },
    "When your Mac is unplugged and running on battery, Vitals automatically switches to this longer refresh interval and reduces expensive sensor reads to save energy." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je Mac odpojený a běží na baterii, Vitals se automaticky přepne na tento delší interval obnovování a omezí náročná čtení senzorů, aby šetřil energii."
          }
        }
      }
    },
